import os

projectName = 'vphysics'

sourceFiles = [
  'extension.cpp',
  'physhandles.cpp',
  'physnatives.cpp',
]

project = builder.LibraryProject(projectName + '.ext')
project.sources += [
  os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp'),
]
project.sources += sourceFiles

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]

  for cxx in builder.targets:
    if cxx.target.arch not in sdk.platformSpec.get(cxx.target.platform, []):
      continue

    binary = Extension.HL2ExtConfig(project, builder, cxx, projectName + '.ext.' + sdk.ext, sdk)

    if binary.compiler.target.platform == 'linux':
      binary.sources += ['linux/glibc_compat.cpp']

Extension.extensions = builder.Add(project)
